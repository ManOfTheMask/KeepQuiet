{
  "name": "keepquiet",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "clean": "rm -rf dist",
    "test": "npm run build; vitest",
    "build": "npm run clean && tsc --build && vite build && npx tailwindcss -i ./src/public/css/input.css -o ./dist/public/css/output.css --minify && cpx 'src/public/**' dist/public",
    "start": "node dist/index.js",
    "dev": "npm run clean && tsc --build && concurrently \"vite build --watch\" \"cpx './src/public/**' ./dist/public --watch\" \"npx tailwindcss -i ./src/public/css/input.css -o ./dist/public/css/output.css --watch\" \"nodemon ./dist/index.js\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@tailwindcss/cli": "^4.1.8",
    "@types/express-session": "^1.18.2",
    "@types/mongoose": "^5.11.96",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-handlebars": "^8.0.3",
    "express-session": "^1.18.1",
    "mongoose": "^8.16.0",
    "openpgp": "^6.1.1",
    "tailwindcss": "^4.1.8",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.29",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitest/ui": "^3.2.4",
    "concurrently": "^9.1.2",
    "cpx2": "^8.0.0",
    "daisyui": "^5.0.43",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
